# WSL Environment Configuration for Crystal
# This file contains environment variables for running Crystal in WSL

# VcXsrv Display Configuration
# Uncomment these lines when using VcXsrv instead of WSLg
# DISPLAY will be set dynamically by the launch script
# LIBGL_ALWAYS_INDIRECT=1

# Electron Configuration
ELECTRON_ENABLE_LOGGING=1
ELECTRON_DISABLE_SANDBOX=1

# Node.js Configuration
NODE_OPTIONS="--max-old-space-size=4096"

# Crystal Development Settings
CRYSTAL_DEV_MODE=true